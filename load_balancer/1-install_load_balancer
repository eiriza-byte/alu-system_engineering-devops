#!/usr/bin/env bash
# Installs HAProxy and balances traffic between web-01 and web-02 using roundrobin
sudo apt-get update -y
sudo apt-get install -y haproxy

if ! grep -q "web_backend" /etc/haproxy/haproxy.cfg; then
    sudo tee -a /etc/haproxy/haproxy.cfg > /dev/null <<'EOF'

frontend http_front
    bind *:80
    mode http
    default_backend web_backend

backend web_backend
    mode http
    balance roundrobin
    server 7297-web-01 18.171.165.68:80 check
    server 7297-web-02 3.8.136.14:80 check
EOF
fi

sudo sed -i 's/^ENABLED=.*/ENABLED=1/' /etc/default/haproxy
sudo service haproxy restart
