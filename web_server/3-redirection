#!/usr/bin/env bash
# Installs nginx and configures a 301 redirect for /redirect_me
apt-get update -y
apt-get install -y nginx
echo "Holberton School for the win!" > /var/www/html/index.nginx-debian.html
if ! grep -q "redirect_me" /etc/nginx/sites-enabled/default
then
  sed -i '/server_name _;/a location /redirect_me { return 301 https://www.youtube.com/watch?v=QH2-TGUlwu4; }' /etc/nginx/sites-enabled/default
fi
service nginx restart
